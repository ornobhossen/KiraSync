rules_version = '2';

// ============================================================================
// KiraSync Firestore Security Rules
// ----------------------------------------------------------------------------
// Principles:
//   1. Everything is denied by default.
//   2. Guests need an authenticated (anonymous) session to order.
//   3. Destructive actions and revenue data require a staff account.
//   4. Documents may only contain the fields the app actually uses.
//   5. Values are type-checked and length-limited to prevent abuse.
//   6. Unknown collections are unreachable.
//
// SETUP:
//   - Enable Anonymous and Email/Password providers in
//     Firebase Console > Authentication > Sign-in method.
//   - Create staff users in Authentication.
//   - Create one document per staff user at staff/{uid}. The client can read
//     its own staff document but can never write to the staff collection.
// ============================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------------------
    // Helpers
    // ------------------------------------------------------------------------
    function signedIn() {
      return request.auth != null;
    }

    // Staff membership is proven by a manually-created staff/{uid} document.
    function isStaff() {
      return signedIn()
        && exists(/databases/$(database)/documents/staff/$(request.auth.uid));
    }

    function validId(id) {
      return id is string && id.matches('^[A-Za-z0-9_-]{1,128}$');
    }

    function validText(value, maxLength) {
      return value is string && value.size() > 0 && value.size() <= maxLength;
    }

    // Optional-field checks are written inline so that a missing field is
    // never evaluated (rules short-circuit on ||).

    // ------------------------------------------------------------------------
    // tables/{tableId}
    // ------------------------------------------------------------------------
    match /tables/{tableId} {
      allow read: if signedIn();

      allow create, update: if signedIn()
        && validId(tableId)
        && request.resource.data.keys().hasOnly(['status', 'updatedAt'])
        && request.resource.data.status in [
             'Available', 'Ordering', 'Seated', 'Payment Pending', 'Fully Paid', 'Paid', 'Cleaning'
           ]
        && (isStaff() || request.resource.data.status == 'Ordering')
        && request.resource.data.updatedAt is string
        && request.resource.data.updatedAt.size() <= 40;

      // Tables are never deleted by the app.
      allow delete: if false;

      // ----------------------------------------------------------------------
      // tables/{tableId}/diners/{dinerId}
      // ----------------------------------------------------------------------
      match /diners/{dinerId} {
        allow read: if signedIn();

        allow create, update: if signedIn()
          && validId(dinerId)
          && request.resource.data.keys().hasOnly([
               'id', 'name', 'initial', 'hasPaid', 'tableId',
               'updatedAt', 'finalTotal', 'paymentMethod', 'paymentRef'
             ])
          && request.resource.data.id == dinerId
          && request.resource.data.tableId == tableId
          && validText(request.resource.data.name, 80)
          && request.resource.data.initial is string
          && request.resource.data.initial.size() <= 4
          && (!request.resource.data.keys().hasAny(['hasPaid'])
              || request.resource.data.hasPaid is bool)
          && (!request.resource.data.keys().hasAny(['updatedAt'])
              || (request.resource.data.updatedAt is string
                  && request.resource.data.updatedAt.size() <= 40))
          && (!request.resource.data.keys().hasAny(['finalTotal'])
              || (request.resource.data.finalTotal is number
                  && request.resource.data.finalTotal >= 0
                  && request.resource.data.finalTotal <= 1000000))
          && (!request.resource.data.keys().hasAny(['paymentMethod'])
              || (request.resource.data.paymentMethod is string
                  && request.resource.data.paymentMethod.size() <= 40))
          && (!request.resource.data.keys().hasAny(['paymentRef'])
              || (request.resource.data.paymentRef is string
                  && request.resource.data.paymentRef.size() <= 40));

        // Only staff may clear diners between groups.
        allow delete: if isStaff();
      }

      // ----------------------------------------------------------------------
      // tables/{tableId}/orders/{orderId}
      // ----------------------------------------------------------------------
      match /orders/{orderId} {
        allow read: if signedIn();

        allow create, update: if signedIn()
          && validId(orderId)
          && request.resource.data.keys().hasOnly([
               'id', 'itemId', 'name', 'price', 'sharedBy', 'status', 'tableId'
             ])
          && request.resource.data.id == orderId
          && request.resource.data.tableId == tableId
          && validText(request.resource.data.itemId, 128)
          && validText(request.resource.data.name, 120)
          && request.resource.data.price is number
          && request.resource.data.price >= 0
          && request.resource.data.price <= 100000
          && request.resource.data.sharedBy is list
          && request.resource.data.sharedBy.size() > 0
          && request.resource.data.sharedBy.size() <= 50
          && request.resource.data.status in ['Pending', 'Preparing', 'Served', 'Cancelled', 'Paid'];

        // Only staff may clear orders between groups.
        allow delete: if isStaff();
      }
    }

    // ------------------------------------------------------------------------
    // Collection group reads
    // The staff dashboard listens to every table's diners and orders at once.
    // Firestore only authorises collection group queries through a rule that
    // matches the collection at any path, so these grant read-only access to
    // staff. Diners read a single table through the nested rules above, so an
    // anonymous session cannot enumerate every table in one query.
    // ------------------------------------------------------------------------
    match /{path=**}/diners/{dinerId} {
      allow read: if isStaff();
    }

    match /{path=**}/orders/{orderId} {
      allow read: if isStaff();
    }

    // ------------------------------------------------------------------------
    // staff/{staffId}
    // The client may read its own membership document so it can confirm
    // access. Membership is managed manually in the Firebase Console.
    // ------------------------------------------------------------------------
    match /staff/{staffId} {
      allow read: if signedIn() && request.auth.uid == staffId;
      allow write: if false;
    }

    // ------------------------------------------------------------------------
    // daily_metrics/{YYYY-MM-DD}
    // Revenue is staff-only. Diners must never read or manipulate the ledger.
    // ------------------------------------------------------------------------
    match /daily_metrics/{metricsDate} {
      allow read: if isStaff();

      allow create, update: if isStaff()
        && metricsDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['collected', 'transactions'])
        && request.resource.data.collected is number
        && request.resource.data.collected >= 0
        && request.resource.data.collected <= 1000000000
        && request.resource.data.transactions is list
        && request.resource.data.transactions.size() <= 10000;

      // Metrics are an append-only ledger; never deleted from the client.
      allow delete: if false;
    }

    // ------------------------------------------------------------------------
    // Everything else is explicitly denied.
    // ------------------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
